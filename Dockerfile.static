# Multi-stage Dockerfile for static Next.js formation/B2B sites
# Usage: docker build --build-arg BUILD_APP=quelle-formation -f Dockerfile.static -t formation-qf .

# --- Stage 1: Build ---
FROM node:22-alpine AS builder

ARG BUILD_APP
RUN test -n "$BUILD_APP" || (echo "ERROR: BUILD_APP arg is required" && exit 1)

WORKDIR /app

# Copy the entire monorepo (needed for workspace resolution)
COPY package.json package-lock.json ./
COPY apps/ apps/

# Install dependencies at monorepo root (resolves workspaces)
RUN npm ci

# Build the target app (static export → produces apps/$BUILD_APP/out/)
RUN cd apps/$BUILD_APP && npm run build

# --- Stage 2: Serve with Nginx ---
FROM nginx:alpine AS runner

ARG BUILD_APP
RUN test -n "$BUILD_APP" || (echo "ERROR: BUILD_APP arg is required" && exit 1)

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy static export from builder
COPY --from=builder /app/apps/$BUILD_APP/out /usr/share/nginx/html

# Copy custom nginx config
COPY nginx-static.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
